rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the requester a signed-in admin? ─────────────
    // Admin identity is a document in admin_users keyed by the auth email.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email));
    }
    function adminRole() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.token.email)).data.role;
    }
    function isSuperAdmin() {
      return isAdmin() && adminRole() in ['super_admin', 'admin'];
    }

    // ── Storefront catalogs: public read; admin-only writes ─────
    match /products/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_variations/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bundles/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bundle_items/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /protocols/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_reviews/{document} {
      allow read: if true;
      // Customers may submit a review; only admins can approve/delete
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Site settings: public read (hero text, notices); admin write ──
    match /site_settings/{document} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── COA reports & guides: public read; admin write ──────────
    match /coa_reports/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /guide_topics/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /articles/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /peptalk_videos/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /page_contents/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Payment methods: PUBLIC READ is FORBIDDEN (account numbers).
    //    The client fetches them through a Cloud Function instead.
    match /payment_methods/{document} {
      allow read, write: if isAdmin();
    }

    // ── Shipping: public read; admin write ──────────────────────
    match /shipping_locations/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shipping_rate_cards/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ph_locations/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shipping_rates/{document} {
      allow read, write: if true; // transitional — see migration note in repo docs
    }

    // ── Promo codes: public validate-only read; admin write ─────
    match /promo_codes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /global_discounts/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Bundle tiers: public read (storefront quantity pricing); admin write ──
    match /product_bundle_tiers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders: customers may create (checkout) and read their own;
    //    only admins may modify ────────────────────────────────────
    match /orders/{document} {
      allow read: if isAdmin() || (request.auth != null
        && (
          resource.data.customer_email == request.auth.token.email
          || resource.data.customer_uid == request.auth.uid
        ));
      allow create: if true; // guest checkout
      allow update, delete: if isAdmin();
    }
    // ── Public order tracking mirror: sanitized status snapshots ──
    // Written ONLY by Cloud Functions (Admin SDK bypasses rules); guests read.
    match /public_order_tracking/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /invoice_verifications/{document} {
      allow read: if isAdmin() || (request.auth != null && resource.data.customer_email == request.auth.token.email);
      allow create: if true; // customers submit payment proofs
      allow update, delete: if isAdmin();
    }
    match /order_timeline/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Customers: self read/write of own doc; admin full ───────
    match /customers/{document} {
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.email == request.auth.token.email || request.auth.uid == document
      ));
      allow create: if true; // guest checkout provisioning
      allow update: if isAdmin() || (request.auth != null && resource.data.email == request.auth.token.email);
      allow delete: if isSuperAdmin();
    }
    match /users/{document} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == document);
      allow create, update: if isAdmin() || (request.auth != null && request.auth.uid == document);
      allow delete: if isSuperAdmin();
    }
    match /subscribers/{document} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /restock_reminders/{document} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /restock_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Admin & audit logs ──────────────────────────────────────
    match /admin_users/{document} {
      // Allow the one-time bootstrap to create the first admin account;
      // subsequent management requires an authenticated admin.
      allow read: if isAdmin() || request.auth == null;
      allow create: if request.auth == null || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /audit_logs/{document} {
      allow read: if isAdmin();
      allow create: if true; // login attempts from unauthenticated clients
      allow update, delete: if false;
    }
    match /admin_audit_logs/{document} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // ── Marketing automation ────────────────────────────────────
    match /email_logs/{document} {
      allow read, write: if isAdmin();
      allow create: if true; // email service writes delivery logs
    }
    match /email_templates/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /email_campaigns/{document} {
      allow read, write: if isAdmin();
    }
    match /email_campaign_recipients/{document} {
      allow read, write: if isAdmin();
    }
    match /email_automations/{document} {
      allow read, write: if isAdmin();
    }
    match /email_suppression/{document} {
      // Public create: one-click unsubscribe writes here without auth
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /follow_ups/{document} {
      allow read, write: if isAdmin();
      allow create: if true; // scheduler + cloud function may create
    }

    // ── Migration ───────────────────────────────────────────────
    match /migration_jobs/{document} {
      allow read, write: if isAdmin();
    }
    match /migration_records/{document} {
      allow read, write: if isAdmin();
    }

    // ── Permissions ─────────────────────────────────────────────
    match /admin_permissions/{document} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Default fallback: DENY everything not explicitly matched ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
