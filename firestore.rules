rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Products, Variations, Bundles & Categories ─────────────
    match /products/{document} {
      allow read, write: if true;
    }
    match /product_variations/{document} {
      allow read, write: if true;
    }
    match /categories/{document} {
      allow read, write: if true;
    }
    match /product_bundle_tiers/{document} {
      allow read, write: if true;
    }
    match /protocols/{document} {
      allow read, write: if true;
    }

    // ── Site settings ────────────────────────────────────────
    match /site_settings/{document} {
      allow read, write: if true;
    }

    // ── COA reports ──────────────────────────────────────────
    match /coa_reports/{document} {
      allow read, write: if true;
    }

    // ── Payment methods ──────────────────────────────────────
    match /payment_methods/{document} {
      allow read, write: if true;
    }

    // ── Shipping ─────────────────────────────────────────────
    match /shipping_locations/{document} {
      allow read, write: if true;
    }

    // ── Promo codes & discounts ──────────────────────────────
    match /promo_codes/{document} {
      allow read, write: if true;
    }
    match /global_discounts/{document} {
      allow read, write: if true;
    }

    // ── Orders & Invoices ────────────────────────────────────
    match /orders/{document} {
      allow read, write: if true;
    }
    match /invoice_verifications/{document} {
      allow read, write: if true;
    }

    // ── Customers & Users ────────────────────────────────────
    match /customers/{document} {
      allow read, write: if true;
    }
    match /users/{document} {
      allow read, write: if true;
    }

    // ── Product reviews ──────────────────────────────────────
    match /product_reviews/{document} {
      allow read, write: if true;
    }

    // ── Subscribers (promo signup) ───────────────────────────
    match /subscribers/{document} {
      allow read, write: if true;
    }

    // ── Page contents (dynamic pages) ────────────────────────
    match /page_contents/{document} {
      allow read, write: if true;
    }

    // ── Restock ──────────────────────────────────────────────
    match /restock_reminders/{document} {
      allow read, write: if true;
    }
    match /restock_settings/{document} {
      allow read, write: if true;
    }

    // ── Guides, Articles & Videos ────────────────────────────
    match /guide_topics/{document} {
      allow read, write: if true;
    }
    match /articles/{document} {
      allow read, write: if true;
    }
    match /peptalk_videos/{document} {
      allow read, write: if true;
    }
    match /faqs/{document} {
      allow read, write: if true;
    }

    // ── Admin & Audit Logs ───────────────────────────────────
    match /admin_users/{document} {
      allow read, write: if true;
    }
    match /audit_logs/{document} {
      allow read, write: if true;
    }
    match /admin_audit_logs/{document} {
      allow read, write: if true;
    }

    // ── Default fallback ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
