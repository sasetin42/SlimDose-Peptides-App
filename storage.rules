rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Payment proofs & receipts: Allow checkout customers to upload payment proofs
    match /payment-proofs/{allPaths=**} {
      allow read, write: if true;
    }

    match /receipts/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Menu images, coas, faqs, and guides
    match /menu-images/{allPaths=**} {
      allow read, write: if true;
    }
    
    match /coas/{allPaths=**} {
      allow read, write: if true;
    }
    
    match /faqs/{allPaths=**} {
      allow read, write: if true;
    }
    
    match /guides/{allPaths=**} {
      allow read, write: if true;
    }

    match /peptalk-videos/{allPaths=**} {
      allow read, write: if true;
    }

    match /peptalk-thumbnails/{allPaths=**} {
      allow read, write: if true;
    }

    // Default public access fallback
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
