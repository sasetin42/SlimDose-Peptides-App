rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read-only access for menu images, coas, faqs, and guides
    match /menu-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /coas/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /faqs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /guides/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Receipts / Invoices: Anyone can submit confirmation receipts,
    // but reading/listing receipts is restricted to authorized store admins
    match /receipts/{allPaths=**} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Default authenticated fallback
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
